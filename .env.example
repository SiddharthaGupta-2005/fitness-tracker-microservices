# ===================================================
# FITPULSE AI - PRODUCTION DOCKER ENVIRONMENT CONFIG
# ===================================================

# OpenRouter AI API Key (Get free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenRouter Model Identifier (defaults to free tier)
OPENROUTER_MODEL=openrouter/free

# PostgreSQL Database Credentials
POSTGRES_DB=fitness_user_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123

# RabbitMQ Credentials
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Keycloak URL (if using external or containerized Keycloak)
KEYCLOAK_URL=http://localhost:8181
